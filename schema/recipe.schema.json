{
  "$id": "recipe.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recipe",
  "type": "object",
  "required": [
    "id", "categories", "origin", "language", "title", "description", "image",
    "time", "calories", "protein", "carbs", "tags", "ingredients", "steps", "source"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["Breakfast", "Lunch", "Snack", "Dinner"] }
    },
    "origin": { "enum": ["curated", "mine"] },
    "language": { "enum": ["en", "fr"] },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "image": { "type": "string", "pattern": "^https://" },
    "time": { "type": "integer", "minimum": 1 },
    "calories": { "type": "integer", "minimum": 0 },
    "protein": { "type": "number", "minimum": 0 },
    "carbs": { "type": "number", "minimum": 0 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "ingredients": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "source": {
      "type": "object",
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string" },
        "url": { "type": "string", "pattern": "^(https://|$)" }
      }
    },
    "notes": { "type": "string" },
    "servings": { "type": "integer", "minimum": 1 },
    "scalableIngredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["quantity", "unit", "name"],
        "properties": {
          "quantity": { "type": "number", "minimum": 0 },
          "unit": { "type": "string" },
          "name": { "type": "string" }
        }
      }
    }
  }
}
